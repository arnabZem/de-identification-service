# Copy to .env; `npm run dev` and `npm start` load it automatically. Real environment variables take precedence.
PORT=3000
MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
# Path relative to the working directory. Leave empty for built-in rules only.
CUSTOM_RULES_FILE=src/rules/custom-rules.json
